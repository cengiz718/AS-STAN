rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Haberler koleksiyonu - Tüm oturum açmış kullanıcılar okuyabilir ve paylaşabilir
    match /teacher_news/{newsId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Ekonomi ve piyasa verileri (Dolar, Euro, Altın)
    match /market_rates/{rateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Tüm cihazlar arasında senkronize edilen tutanaklar ve evraklar
    match /shared_documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);
    }

    // turkcen.net materyalleri ve canlı arşiv
    match /turkcen_resources/{resId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Kullanıcı profilleri
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
